/* =========================================================
   GREAT CIRCLE
   ========================================================= */

function geoVector(lat,lng){

    const latR =
        lat*Math.PI/180;

    const lngR =
        lng*Math.PI/180;

    return {

        x:
            Math.cos(latR) *
            Math.cos(lngR),

        y:
            Math.sin(latR),

        z:
            Math.cos(latR) *
            Math.sin(lngR)

    };

}


function vectorGeo(v){

    const length =
        Math.sqrt(
            v.x*v.x +
            v.y*v.y +
            v.z*v.z
        );

    const x =
        v.x/length;

    const y =
        v.y/length;

    const z =
        v.z/length;

    return {

        lat:
            Math.asin(y) *
            180/Math.PI,

        lng:
            Math.atan2(z,x) *
            180/Math.PI

    };

}


function interpolate(a,b,t){

    const A =
        geoVector(
            a.lat,
            a.lng
        );

    const B =
        geoVector(
            b.lat,
            b.lng
        );


    let dot =
        A.x*B.x +
        A.y*B.y +
        A.z*B.z;


    dot =
        Math.max(
            -1,
            Math.min(1,dot)
        );


    const angle =
        Math.acos(dot);


    if(angle < .0001){

        return {

            lat:
                a.lat +
                (b.lat-a.lat)*t,

            lng:
                a.lng +
                (b.lng-a.lng)*t

        };

    }


    const sinAngle =
        Math.sin(angle);


    const p1 =
        Math.sin(
            (1-t)*angle
        ) /
        sinAngle;


    const p2 =
        Math.sin(
            t*angle
        ) /
        sinAngle;


    return vectorGeo({

        x:
            A.x*p1 +
            B.x*p2,

        y:
            A.y*p1 +
            B.y*p2,

        z:
            A.z*p1 +
            B.z*p2

    });

}


