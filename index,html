function formatTime12(timeString){

    if(!timeString){
        return "NOT SET";
    }

    const parts =
        timeString.split(":");

    let hour =
        Number(parts[0]);

    const minute =
        Number(parts[1]);

    const ampm =
        hour >= 12 ? "PM" : "AM";

    hour =
        hour % 12 || 12;

    return (
        hour +
        ":" +
        String(minute).padStart(2,"0") +
        " " +
        ampm
    );
}


function getArrivalDate(){

    let saved = null;

    try{

        saved =
            JSON.parse(
                localStorage.getItem(
                    "santaParentSettings"
                ) || "null"
            );

    }catch(error){

        return null;

    }

    if(!saved || !saved.time){

        return null;

    }

    const parts =
        saved.time.split(":");

    const now =
        new Date();

    const arrival =
        new Date();

    arrival.setHours(
        Number(parts[0]),
        Number(parts[1]),
        0,
        0
    );

    if(arrival <= now){

        arrival.setDate(
            arrival.getDate()+1
        );

    }

    return arrival;
}


function updateArrivalCountdown(){

    const arrival =
        getArrivalDate();

    if(!arrival){

        arrivalClock.textContent =
            "NOT CALCULATED";

        arrivalCountdown.textContent =
            "Set an arrival time in Parent Settings.";

        return;

    }

    arrivalClock.textContent =
        arrival.toLocaleTimeString(
            [],
            {
                hour:"numeric",
                minute:"2-digit"
            }
        );

    const difference =
        arrival.getTime() -
        Date.now();

    if(difference <= 0){

        arrivalCountdown.textContent =
            "🎅 ARRIVAL TIME REACHED";

        return;

    }

    const totalSeconds =
        Math.floor(
            difference / 1000
        );

    const hours =
        Math.floor(
            totalSeconds / 3600
        );

    const minutes =
        Math.floor(
            (totalSeconds % 3600) / 60
        );

    const seconds =
        totalSeconds % 60;

    arrivalCountdown.textContent =
        "⏱ " +
        hours +
        "h " +
        minutes +
        "m " +
        seconds +
        "s until arrival";

}

