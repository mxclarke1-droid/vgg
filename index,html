/* =========================================================
   SANTA ANIMATION
   ========================================================= */

function animate(time){

    if(
        trackingStarted &&
        santaLoaded &&
        santaRoute.length > 1
    ){

        const elapsed =
            time -
            flightStartTime;


        const total =
            (
                santaRoute.length - 1
            ) *
            segmentDuration;


        const clamped =
            Math.min(
                Math.max(
                    elapsed,
                    0
                ),
                total
            );


        const segmentFloat =
            clamped /
            segmentDuration;


        const index =
            Math.min(
                Math.floor(
                    segmentFloat
                ),
                santaRoute.length-2
            );


        const t =
            segmentFloat -
            index;


        const start =
            santaRoute[index];


        const end =
            santaRoute[
                index+1
            ];


        const position =
            interpolate(
                start,
                end,
                t
            );


        santaObjectData[0].lat =
            position.lat;

        santaObjectData[0].lng =
            position.lng;

        santaObjectData[0].altitude =
            SANTA_ALTITUDE;


        /*
           Refresh the Globe.gl object position.
        */

        globe.objectsData(
            santaObjectData
        );


        if(clamped >= total){

            locationElement.textContent =
                end.name.toUpperCase();


            routeStatus.textContent =
                "ARRIVED";


            trackingStatus.textContent =
                "SANTA HAS ARRIVED";


            arrivalCountdown.textContent =
                "🎅 SANTA HAS ARRIVED!";


        }else{

            locationElement.textContent =
                start.name.toUpperCase();


            routeStatus.textContent =
                "TO " +
                end.name.toUpperCase();

        }

    }


    requestAnimationFrame(
        animate
    );

}


requestAnimationFrame(
    animate
);

