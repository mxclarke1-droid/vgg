/* =========================================================
   LOAD THE EXISTING SANTA GLB
   ========================================================= */

function loadSantaModel(){

    modelNotice.style.display =
        "block";

    modelNotice.textContent =
        "🛷 Loading Santa's sleigh...";


    console.log(
        "🎅 Starting Santa GLB loader..."
    );


    const modelURL =
        new URL(
            MODEL_FILE,
            window.location.href
        ).href;


    console.log(
        "Looking for Santa at:",
        modelURL
    );


    if(typeof THREE === "undefined"){

        console.error(
            "Three.js did not load."
        );

        modelNotice.textContent =
            "⚠️ Three.js failed to load.";

        return;

    }


    if(
        typeof THREE.GLTFLoader ===
        "undefined"
    ){

        console.error(
            "GLTFLoader did not load."
        );

        modelNotice.textContent =
            "⚠️ GLTFLoader failed to load.";

        return;

    }


    const loader =
        new THREE.GLTFLoader();


    loader.load(

        modelURL,

        function(gltf){

            console.log(
                "🎅 santa_-_norad_santa_tracker.glb loaded!"
            );


            /*
               Keep the original GLB scene.
            */

            santaModelTemplate =
                gltf.scene;


            /*
               =========================================
               GLOBE.GL MODEL SIZE FIX
               =========================================

               The model itself is already made.
               We are only calculating its dimensions
               so Globe.gl can display it properly.
            */

            const originalBox =
                new THREE.Box3().setFromObject(
                    santaModelTemplate
                );


            const originalSize =
                new THREE.Vector3();


            const originalCenter =
                new THREE.Vector3();


            originalBox.getSize(
                originalSize
            );


            originalBox.getCenter(
                originalCenter
            );


            console.log(
                "Original Santa model size:",
                originalSize
            );


            /*
               Center the model around its origin.

               This is important because a GLB can have
               its mesh far away from its origin.
            */

            santaModelTemplate.position.sub(
                originalCenter
            );


            /*
               Find the largest dimension.
            */

            const largestDimension =
                Math.max(
                    originalSize.x,
                    originalSize.y,
                    originalSize.z
                );


            if(
                largestDimension > 0 &&
                Number.isFinite(
                    largestDimension
                )
            ){

                const scaleFactor =
                    SANTA_MODEL_SIZE /
                    largestDimension;


                santaModelTemplate.scale.set(
                    scaleFactor,
                    scaleFactor,
                    scaleFactor
                );


                console.log(
                    "Santa model scale factor:",
                    scaleFactor
                );

            }else{

                /*
                   Safety fallback.
                */

                santaModelTemplate.scale.set(
                    1,
                    1,
                    1
                );

            }


            /*
               Make every mesh visible.
            */

            santaModelTemplate.traverse(
                function(object){

                    if(object.isMesh){

                        object.visible =
                            true;

                        object.frustumCulled =
                            false;


                        if(object.material){

                            if(
                                Array.isArray(
                                    object.material
                                )
                            ){

                                object.material.forEach(
                                    material => {

                                        material.visible =
                                            true;

                                        material.needsUpdate =
                                            true;

                                    }
                                );

                            }else{

                                object.material.visible =
                                    true;

                                object.material.needsUpdate =
                                    true;

                            }

                        }

                    }

                }
            );


            /*
               Santa is officially loaded.
            */

            santaLoaded =
                true;


            /*
               Force Globe.gl to create a fresh
               3D object from the loaded GLB.
            */

            globe.objectsData(
                []
            );


            setTimeout(
                function(){

                    globe.objectsData(
                        santaObjectData
                    );

                },
                50
            );


            modelNotice.style.display =
                "none";


            console.log(
                "🎅 Santa GLB is ready for Globe.gl."
            );


            console.log(
                "🎅 Santa normalized size:",
                SANTA_MODEL_SIZE
            );

        },

        function(xhr){

            if(
                xhr &&
                xhr.total
            ){

                const percent =
                    Math.round(
                        xhr.loaded /
                        xhr.total *
                        100
                    );


                modelNotice.textContent =
                    "🛷 Loading Santa's sleigh... " +
                    percent +
                    "%";

            }

        },

        function(error){

            console.error(
                "❌ Santa GLB loading error:",
                error
            );


            modelNotice.textContent =
                "⚠️ santa_-_norad_santa_tracker.glb could not be loaded.";

        }

    );

}


