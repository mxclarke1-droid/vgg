/*
   Create a new copy of the already-loaded GLB
   for Globe.gl.
*/

function createSantaObject(){

    if(!santaModelTemplate){

        console.warn(
            "Santa template isn't loaded yet."
        );

        return new THREE.Group();

    }


    const santa =
        santaModelTemplate.clone(
            true
        );


    /*
       The GLB was already made for us.
       We are NOT changing the original file.

       This copy simply uses the normalized
       size calculated when the file loaded.
    */

    santa.position.set(
        0,
        0,
        0
    );


    santa.visible =
        true;


    santa.traverse(
        function(object){

            if(object.isMesh){

                object.visible =
                    true;

                object.frustumCulled =
                    false;

                if(object.material){

                    if(
                        Array.isArray(
                            object.material
                        )
                    ){

                        object.material.forEach(
                            material => {

                                material.visible =
                                    true;

                                material.needsUpdate =
                                    true;

                            }
                        );

                    }else{

                        object.material.visible =
                            true;

                        object.material.needsUpdate =
                            true;

                    }

                }

            }

        }
    );


    return santa;

}


